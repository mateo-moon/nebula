+#[cfg(test)]
+mod fail_closed_challenge_tests {
+    use super::*;
+    use wiremock::{matchers::{method, path}, Mock, MockServer, ResponseTemplate};
+
+    #[tokio::test]
+    async fn fail_closed_challenge() {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/challenge"))
+            .respond_with(ResponseTemplate::new(400).set_body_string("Failed to get inner tee"))
+            .mount(&server)
+            .await;
+        let converter = CocoRestfulConverter::new(&server.uri(), &vec!["default".into()], &HashMap::new()).unwrap();
+        assert!(converter.get_nonce().await.is_err());
+    }
+}
