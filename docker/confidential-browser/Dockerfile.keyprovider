FROM rust:1.93.1-bookworm@sha256:1d33950f982ca6411f5e0ee4850be46e03f066f1a9efaeb41922a0e59497c9c2 AS build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /guest-components
# Build context is upstream guest-components at the pinned revision recorded in
# versions.json. Only the key provider is built; skopeo comes from Debian.
COPY . .
RUN cargo build --locked --release -p coco_keyprovider -j 2
FROM scratch
COPY --from=build /guest-components/target/release/coco_keyprovider /coco_keyprovider
LABEL org.opencontainers.image.source=https://github.com/confidential-containers/guest-components
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
