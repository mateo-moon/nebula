+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tss::{EndorsementKey, MessageBuffer};
+    use std::cell::RefCell;
+    use tss_esapi::{
+        constants::{CapabilityType, Tss2ResponseCodeKind},
+        handles::AuthHandle,
+        structures::{Auth, CapabilityData},
+    };
+
+    #[test]
+    #[ignore = "isolated software TPM only; never a host TPM"]
+    fn protected_owner_survives_attestation_objects_and_context_recreation() {
+        assert_eq!(std::env::var("NEBULA_SWTPM_TEST").as_deref(), Ok("1"));
+        // The test-only constructor cannot select a physical TPM.
+        let endpoint = std::env::var("NEBULA_SWTPM_PORT")
+            .unwrap()
+            .parse::<u16>()
+            .unwrap();
+        let conf: tss_esapi::TctiNameConf = format!("swtpm:host=127.0.0.1,port={endpoint}")
+            .parse()
+            .unwrap();
+        let owner = Auth::try_from(vec![91; 32]).unwrap();
+        let make = |auth| {
+            RefCell::new(TpmManager {
+                device_path: "/dev/tpm0".into(),
+                mode: Mode::None,
+                owner_auth: auth,
+                test_tcti: Some(conf.clone()),
+            })
+        };
+        let initial = make(Auth::default());
+        initial
+            .borrow_mut()
+            .tss()
+            .unwrap()
+            .execute_with_nullauth_session(|context| {
+                context.hierarchy_change_auth(AuthHandle::Owner, owner.clone())
+            })
+            .unwrap();
+        drop(initial);
+        let empty = make(Auth::default());
+        let error = match EndorsementKey::new(&empty) {
+            Ok(_) => panic!("empty owner authorization accepted"),
+            Err(error) => error,
+        };
+        match error {
+            crate::tss::endorsement_key::Error::Tss(tss_esapi::Error::Tss2Error(code)) => {
+                assert!(matches!(
+                    code.kind(),
+                    Some(Tss2ResponseCodeKind::BadAuth | Tss2ResponseCodeKind::AuthFail)
+                ))
+            }
+            _ => panic!("wrong failure category for owner authorization"),
+        }
+        drop(empty);
+        let manager = make(owner.clone());
+        let endorsement = EndorsementKey::new(&manager).unwrap();
+        let request = crate::nsm_api::Request::Attestation {
+            user_data: None,
+            nonce: None,
+            public_key: None,
+        };
+        let (buffer, _) =
+            MessageBuffer::from_request(&manager, endorsement.tpm_handle(), &request).unwrap();
+        // The actual vendor request closes/reopens ESAPI. Test that transition
+        // independently of the AWS-only vendor command, then authenticated drop.
+        manager.borrow_mut().mode = Mode::None;
+        drop(buffer);
+        drop(endorsement);
+        for property in [
+            tss_esapi::constants::tss::TPM2_PERSISTENT_FIRST,
+            tss_esapi::constants::tss::TPM2_NV_INDEX_FIRST,
+        ] {
+            let (found, _) = manager
+                .borrow_mut()
+                .tss()
+                .unwrap()
+                .execute_without_session(|context| {
+                    context.get_capability(CapabilityType::Handles, property, 64)
+                })
+                .unwrap();
+            match found {
+                CapabilityData::Handles(handles) => assert!(handles.into_inner().is_empty()),
+                _ => panic!("invalid handles response"),
+            }
+        }
+        // It was never reset to empty to make attestation work.
+        let empty = make(Auth::default());
+        assert!(EndorsementKey::new(&empty).is_err());
+    }
+}
