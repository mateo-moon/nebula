+impl Error {
+    /// A finite public diagnostic code; never serialize an error or its inputs.
+    pub fn diagnostic_exit_code(&self) -> i32 {
+        use tss::endorsement_key::Error as Ek;
+        match self {
+            Self::EndorsementKey(error) => match error {
+                Ek::PersistentHandleCapacity => 70,
+                Ek::TpmManager(_) => 71,
+                Ek::CreatePrimary(error) => endorsement_tss_code(*error, 80, 72),
+                Ek::Persist(error) => endorsement_tss_code(*error, 81, 73),
+                Ek::Tss(error) => endorsement_tss_code(*error, 82, 74),
+                Ek::AwsLc(_) => 84,
+                Ek::Asn1Der(_) => 85,
+            },
+            Self::MessageBuffer(_) => 65,
+            Self::NsmRequest(_) => 66,
+            Self::Tss(_) => 67,
+            Self::NsmErrorResponse(_) => 68,
+            Self::InvalidNsmResponse => 69,
+        }
+    }
+}
+
+fn endorsement_tss_code(error: tss_esapi::Error, fallback: i32, authentication: i32) -> i32 {
+    use tss_esapi::constants::Tss2ResponseCodeKind as Kind;
+    match error {
+        tss_esapi::Error::WrapperError(_) => 83,
+        tss_esapi::Error::Tss2Error(code) => match code.kind() {
+            Some(Kind::AuthFail | Kind::BadAuth | Kind::AuthMissing | Kind::AuthUnavailable) => {
+                authentication
+            }
+            Some(Kind::Lockout) => 75,
+            Some(Kind::ObjectMemory | Kind::ObjectHandles) => 76,
+            Some(Kind::SessionMemory | Kind::SessionHandles) => 77,
+            Some(Kind::Memory | Kind::NvSpace) => 78,
+            Some(
+                Kind::Handle
+                | Kind::NvDefined
+                | Kind::ReferenceH0
+                | Kind::ReferenceH1
+                | Kind::ReferenceH2,
+            ) => 79,
+            Some(
+                Kind::Size
+                | Kind::Value
+                | Kind::KeySize
+                | Kind::Attributes
+                | Kind::Scheme
+                | Kind::Symmetric,
+            ) => 86,
+            _ => fallback,
+        },
+    }
+}
